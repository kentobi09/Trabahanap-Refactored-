{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/:match*",
      "destination": "https://ediskarte-admin-api.onrender.com/admin/:match*"
    },
    {
      "source": "/assets/:match*",
      "destination": "https://ediskarte-api.onrender.com/assets/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
